# ==============================================================================
# The Shortest Orbit - Environment Configuration Template
# Copy this file to '.env' and fill in your actual API keys and secrets.
# ==============================================================================

# --- AI & LLM Providers (Required for Scriptwriting & Metadata) ---
# Groq: Free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Gemini: Free API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Stock Footage Providers (Required for Video Assembly) ---
# Pexels: Free API key from https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay: Free API key from https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# --- Meta Automation (Facebook & Instagram Reels) ---
# Meta Graph API credentials for auto-posting Reels
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_ACCESS_TOKEN=your_meta_long_lived_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
ENABLE_META_AI_DUBBING=True

# --- Optional Cloud Generative Providers (Leave blank if using stock footage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
FAL_KEY=
REPLICATE_API_TOKEN=
